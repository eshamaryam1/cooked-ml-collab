# env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*

# data and models are tracked by DVC, never by Git.
# No blanket `data/raw/*` here: dulwich (DVC's default git backend) treats a
# `dir/*` pattern as "the directory itself is ignored" and prunes it from the
# walk DVC uses to find *.dvc pointers, which silently hides them from
# status/push/pull. DVC writes data/raw/.gitignore itself on `dvc add`.
data/raw/sklearn_cache/
data/processed/*
data/processed_smoke/*
models/*
!data/raw/.gitkeep
!models/.gitkeep

# tooling caches
.dvc/cache/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
mlruns/
wandb/
.DS_Store
